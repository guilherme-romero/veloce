[Unit]
Description=Veloce — limpeza periódica do journal (logs via journald)

[Service]
Type=oneshot
# O backend só escreve em StandardOutput/StandardError=journal (ver
# veloce-api.service) — não há arquivo de log próprio da app pra
# rotacionar, então a limpeza é do journal do systemd como um todo.
# --vacuum-time opera sobre o journal inteiro (journald não segmenta por
# unit em arquivos separados sem namespace dedicado), então isto também
# limita o histórico de outras units do sistema — aceitável neste host
# (single-purpose, só roda o backend e o backup).
#
# Precisa de root: journalctl --vacuum-time exige escrita em /var/log/journal
# (dir root:systemd-journal, grupo só tem leitura). Diferente de
# veloce-backup.service, que roda como `prod` — não copiar esse padrão
# pra esta unit (achado de revisão de infra).
User=root
ProtectSystem=strict
ReadWritePaths=/var/log/journal
ProtectHome=yes
NoNewPrivileges=yes
ExecStart=/usr/bin/journalctl --vacuum-time=30d
StandardOutput=journal
StandardError=journal
