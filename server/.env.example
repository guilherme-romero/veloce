# ─── Credenciais ────────────────────────────────────────────────
# Usuario unico do sistema (single-user)
ADMIN_USER=guilherme

# Hash bcrypt da senha — gerar com: npm run hash-password <senha>
# Cole aqui o output completo (comeca com $2b$12$...)
ADMIN_PASS_HASH=

# ─── JWT ────────────────────────────────────────────────────────
# Segredo para assinar tokens. Gere algo aleatorio longo:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Duracao da sessao em dias
SESSION_DAYS=7

# ─── Servidor ───────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1

# Habilita Secure flag nos cookies (true em prod com HTTPS)
COOKIE_SECURE=false

# Origens permitidas pelo CORS (lista separada por virgula). Default cobre
# producao + dev; sobrescreva se o dominio mudar.
#   ALLOWED_ORIGINS=https://bike.arkhamcloud.net,http://localhost:8000

# ─── Banco / cookie (opcionais) ─────────────────────────────────
# Defaults preservam o comportamento single-user. Uma 2a instancia
# (ex.: demo) sobrescreve DB_PATH/COOKIE_NAME para rodar isolada.
#   DATA_DIR=/caminho/para/data
#   DB_PATH=/caminho/para/data/training.db
#   COOKIE_NAME=tb_session
#   COOKIE_PATH=/
# ENV_FILE (via systemd) faz o config carregar outro .env em vez deste.
# Ver .env.demo.example e treino-bike-demo.service.

# ─── Strava (Fase 4) ────────────────────────────────────────────
# Registre o app em https://www.strava.com/settings/api
# Como o sistema e single-user, usamos o refresh_token do proprio
# dono do app (visivel na pagina de settings) — sem fluxo OAuth.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# ─── Garmin Connect (Fase 4.5) ──────────────────────────────────
# Credenciais sao usadas SO no primeiro login (sessao SSO persistida
# em data/garmin_session/). Se a conta tem MFA, o primeiro login
# precisa do codigo via CLI: garmin_cli.py login --mfa <codigo>.
GARMIN_EMAIL=
GARMIN_PASSWORD=
