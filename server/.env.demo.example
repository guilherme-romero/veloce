# ═══════════════════════════════════════════════════════════════════════
# .env.demo — instancia de DEMONSTRACAO (login user/user, dados mockados)
# Copie para .env.demo e ajuste. NAO inclua credenciais Strava/Garmin aqui:
# a ausencia delas faz as integracoes aparecerem como "desconectado".
#
# Isolamento: o systemd desta instancia define ENV_FILE apontando para este
# arquivo, entao o config.js carrega SO este .env.demo — nunca o server/.env
# de producao (que tem os tokens reais). Ver treino-bike-demo.service.
# ═══════════════════════════════════════════════════════════════════════

# Credenciais do demo (senha "user"). Gere o hash com:
#   node -e "require('./utils/password').hash('user').then(console.log)"
ADMIN_USER=user
ADMIN_PASS_HASH=$2b$12$GOw28Wtw4gHP6h1s8Er/J.E.Do4kEvl26lDgcvLVBKS3ZZQ7w6.Ki

# Segredo JWT proprio (troque por um valor aleatorio distinto do de producao)
JWT_SECRET=troque-por-um-segredo-aleatorio-do-demo
SESSION_DAYS=7

# Servidor — porta distinta da producao (3000)
PORT=3001
HOST=127.0.0.1

# Cookie — atras de HTTPS (Cloudflare) e nome proprio (defesa extra;
# o subdominio ja isola por host)
COOKIE_SECURE=true
COOKIE_NAME=tb_session_demo
COOKIE_PATH=/

# Banco proprio do demo (caminho absoluto). Gere com scripts/seed-demo.js.
DB_PATH=/home/prod/env/prod/treino_bike/data/demo.db

# (Strava/Garmin propositalmente ausentes — demo nao integra)
